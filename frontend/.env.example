# Backend HTTP base URL for REST requests
VITE_API_URL=http://localhost:3000

# WebSocket base URL for Socket.IO navigation updates
VITE_WS_URL=http://localhost:3000

# Backward-compatible fallback for older API consumers
VITE_BACKEND_URL=http://localhost:3000

# Default map center (Tunis)
VITE_MAP_DEFAULT_LAT=36.8068
VITE_MAP_DEFAULT_LNG=10.1816
VITE_MAP_DEFAULT_ZOOM=14
