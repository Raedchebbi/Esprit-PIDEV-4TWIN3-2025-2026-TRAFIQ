# NestJS HTTP server port
BACKEND_PORT=3000

# Allowed frontend origin(s), comma-separated if needed
CORS_ORIGIN=http://localhost:5173

# Default Socket.IO namespace for admin/live events
WS_NAMESPACE=/

# Required in production. Use a long random value; do not commit real secrets.
JWT_SECRET=replace_with_long_random_jwt_secret

# Optional initial production admin. If omitted in production, no default users are seeded.
INITIAL_SUPER_ADMIN_EMAIL=admin@example.com
INITIAL_SUPER_ADMIN_PASSWORD=replace_with_initial_admin_password
INITIAL_SUPER_ADMIN_NAME=Initial Super Admin

# Local/demo only. Set false to disable non-production demo users.
SEED_DEMO_USERS=true

# Required in production for Python AI engine Socket.IO producer authentication.
AI_WS_TOKEN=replace_with_long_random_ai_ws_token

# Optional MongoDB integration for AI events, incidents, and telemetry.
# Leave MONGODB_URI unset to keep MongoDB disabled without changing existing behavior.
# MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=trafiq
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_TTL_DAYS=30
MONGODB_FAIL_FAST=false
USE_MONGO_AS_PRIMARY=false

# Active MongoDB intelligence defaults
HISTORICAL_RISK_LOOKBACK_DAYS=14
GEO_NOTIFICATION_RADIUS_METERS=30
USER_SESSION_ACTIVE_MINUTES=10

# Optional Redis integration for Socket.IO horizontal scaling and central sessions.
USE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_redis_password_if_required
USE_CENTRAL_SESSIONS=false

# HTTP rate limits
RATE_LIMIT_LOGIN_LIMIT=5
RATE_LIMIT_LOGIN_TTL_MS=60000
RATE_LIMIT_NAV_START_LIMIT=20
RATE_LIMIT_NAV_START_TTL_MS=60000
RATE_LIMIT_NAV_UPDATE_LIMIT=120
RATE_LIMIT_NAV_UPDATE_TTL_MS=60000
RATE_LIMIT_NAV_END_LIMIT=30
RATE_LIMIT_NAV_END_TTL_MS=60000
RATE_LIMIT_PUBLIC_ROUTE_LIMIT=60
RATE_LIMIT_PUBLIC_ROUTE_TTL_MS=60000

# WebSocket event rate limits
RATE_LIMIT_AI_WS_LIMIT=600
RATE_LIMIT_AI_WS_TTL_MS=60000
RATE_LIMIT_PUBLIC_WS_POSITION_LIMIT=120
RATE_LIMIT_PUBLIC_WS_POSITION_TTL_MS=60000
RATE_LIMIT_PUBLIC_WS_SUBSCRIBE_LIMIT=30
RATE_LIMIT_PUBLIC_WS_SUBSCRIBE_TTL_MS=60000
