# Groq API key for optional risk assessment
GROQ_API_KEY=replace_with_groq_api_key

# Toggle optional Groq-based risk assessment
ENABLE_RISK_ASSESSMENT=true

# NestJS backend base URL for REST and Socket.IO events
NESTJS_URL=http://localhost:3000

# Shared producer token sent in the Socket.IO handshake to authenticate the AI engine
AI_WS_TOKEN=replace_with_long_random_ai_ws_token

# Optional override for the shared camera registry
CAMERAS_CONFIG=./cameras.json

# File touched after camera/model startup so Docker/Kubernetes probes can check readiness
AI_HEALTH_FILE=/tmp/trafiq-ai-ready

# Local display for OpenCV debugging
SHOW_DISPLAY=false

# Detection and collision thresholds
BASE_CONF=0.35
IOU_THRESHOLD=0.4
IOU_MAX_THRESHOLD=0.85
PROXIMITY_THRESHOLD=0.18
MIN_PAIR_CONF=0.5
SPEED_DROP_THRESHOLD=12
MIN_BOX_AREA=3000
MIN_BOX_SIZE_RATIO=0.25
SPEED_HIGH_THRESHOLD=8.0
CONFIRMATION_FRAMES=3
COOLDOWN_FRAMES=500
MIN_INCIDENT_CONF=0.55

# Runtime pacing
RISK_FRAME_INTERVAL=60
MIN_GROQ_INTERVAL_S=15
VEHICLE_COUNT_INTERVAL=15
MAX_RECONNECT_ATTEMPTS=10

# Demo runner helper
CLEAR_INCIDENTS_ON_START=false
